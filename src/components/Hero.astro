---
// src/components/Hero.astro
---

<section class="max-w-6xl mx-auto py-24 md:py-32">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
    
    <!-- Left Column: The Bio -->
    <div class="flex flex-col space-y-6">
      <div class="inline-block">
        <span class="bg-flow/10 text-flow border border-flow/20 rounded-full px-3 py-1 text-sm font-mono uppercase tracking-wider">
          Computational Engineer
        </span>
      </div>
      
      <h1 class="font-display text-5xl md:text-6xl text-ink tracking-tight leading-tight">
        Modeling the physics of <br/> <span class="text-flow">fluid dynamics.</span>
      </h1>
      
      <p class="text-ink-muted text-lg leading-relaxed max-w-md mt-4">
        Hi, I'm Martin. I specialize in CFD, hydrodynamics, and numerical modelling. When I'm not chasing convergence in OpenFOAM, I'm exploring Europe's railways or collaborating on global engineering projects.
      </p>
      
      <div class="flex flex-wrap gap-4 pt-6">
        <a href="/projects" class="font-mono text-sm bg-flow text-void px-6 py-3 rounded shadow-glow-flow hover:brightness-110 transition text-center">
          View Projects
        </a>
        <a href="/about" class="font-mono text-sm border border-hairline px-6 py-3 rounded text-ink-muted hover:text-flow hover:border-flow/40 transition-colors text-center">
          More About Me
        </a>
      </div>
    </div>

    <!-- Right Column: The Photo -->
    <div class="relative group mx-auto md:ml-auto md:mr-10 w-64 md:w-80 mt-10 md:mt-0">
      <!-- Decorative background glow -->
      <div class="absolute -inset-1 bg-gradient-to-r from-flow to-cyan-600 rounded-2xl blur opacity-20 group-hover:opacity-40 transition duration-1000 group-hover:duration-200"></div>
      
      <!-- The Image -->
      <img 
        src="/images/martin-profile.jpg" 
        alt="Martin Mathew" 
        class="relative rounded-2xl border border-gray-800 shadow-2xl object-cover aspect-[4/5] grayscale group-hover:grayscale-0 transition-all duration-700 ease-in-out z-10"
      />
      
      <!-- Decorative tech accents -->
      <div class="absolute -bottom-4 -right-4 bg-void border border-hairline px-3 py-2 rounded font-mono text-xs text-flow shadow-lg hidden md:block z-20">
        $ ./run_simulation.sh
      </div>
    </div>

  </div>
</section>