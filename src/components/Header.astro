---
const nav = [
  { href: "/projects", label: "Projects" },
  { href: "/collaborations", label: "Collaborations" },
  { href: "/stories", label: "Stories" },
  { href: "/about", label: "About" },
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-50">
  <div class="glass-panel">
    <nav
      class="max-w-6xl mx-auto flex items-center justify-between px-6 py-4"
    >
      <a
        href="/"
        class="font-display text-lg tracking-tight text-ink hover:text-flow transition-colors"
      >
        martin<span class="text-flow">.</span>sim
      </a>

      <ul class="hidden sm:flex items-center gap-8 font-mono text-sm">
        {
          nav.map((item) => {
            const active = path.startsWith(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "transition-colors hover:text-flow",
                    active ? "text-flow" : "text-ink-muted",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>

      <a
        href="/cv/martin-cv.pdf"
        class="hidden sm:inline-flex items-center gap-2 font-mono text-xs border border-hairline rounded px-3 py-2 text-ink-muted hover:text-flow hover:border-flow/50 transition-colors"
        download
      >
        CV
      </a>

      <!-- mobile nav toggle -->
      <button
        id="nav-toggle"
        type="button"
        class="sm:hidden text-ink-muted hover:text-flow transition-colors"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg class="nav-icon-menu" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <path
            d="M3 6h16M3 11h16M3 16h16"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
        <svg class="nav-icon-close hidden" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <path d="M5 5l12 12M17 5L5 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
    </nav>

    <ul
      id="mobile-nav"
      class="sm:hidden hidden flex-col gap-1 border-t border-hairline px-6 pb-4 pt-3 font-mono text-sm"
    >
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={["block border-l-2 py-2 pl-3 transition-colors hover:text-flow", path.startsWith(item.href) ? "border-flow text-flow" : "border-transparent text-ink-muted"]}
              aria-current={path.startsWith(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/cv/martin-cv.pdf" class="block border-l-2 border-transparent py-2 pl-3 text-ink-muted hover:text-flow" download>
          Download CV
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-nav");
  const menuLinks = menu?.querySelectorAll("a");

  const setMenuOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    menu.classList.toggle("hidden", !open);
    menu.classList.toggle("flex", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu");
    toggle.querySelector(".nav-icon-menu")?.classList.toggle("hidden", open);
    toggle.querySelector(".nav-icon-close")?.classList.toggle("hidden", !open);
  };

  toggle?.addEventListener("click", () => {
    setMenuOpen(toggle.getAttribute("aria-expanded") !== "true");
  });
  menuLinks?.forEach((link) => link.addEventListener("click", () => setMenuOpen(false)));
  document.addEventListener("click", (event) => {
    if (toggle?.getAttribute("aria-expanded") === "true" && !menu?.contains(event.target as Node) && !toggle.contains(event.target as Node)) {
      setMenuOpen(false);
    }
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenuOpen(false);
  });
  window.addEventListener("resize", () => {
    if (window.matchMedia("(min-width: 640px)").matches) setMenuOpen(false);
  });
</script>
