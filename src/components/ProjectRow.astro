---
import TechBadge from "./TechBadge.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  index: number;
  href: string;
  title: string;
  summary: string;
  stack: string[];
  tags?: string[];
  solver?: string;
  metrics?: { label: string; value: string }[];
  status: "ongoing" | "complete" | "archived";
  date: Date;
  coverImage?: ImageMetadata;
  featured?: boolean;
}
const {
  index,
  href,
  title,
  summary,
  stack,
  tags = [],
  solver,
  metrics = [],
  status,
  date,
  coverImage,
  featured = false,
} = Astro.props;

const statusColor =
  status === "ongoing"
    ? "text-flow"
    : status === "complete"
      ? "text-ink-muted"
      : "text-ink-faint";

const year = date.getFullYear();
---

<a href={href} class:list={["group block spec-row project-row", featured && "project-row--featured"]}>
  <div class="grid sm:grid-cols-[3rem_1fr_auto] gap-4 sm:gap-8 items-start py-7 sm:py-8">
    <span class="font-mono text-sm text-ink-faint pt-1" aria-hidden="true">
      {String(index).padStart(2, "0")}
    </span>

    <div>
      {coverImage && (
        <div class="float-right mb-4 ml-5 w-32 overflow-hidden rounded border border-hairline bg-void-raised sm:w-48">
          <Image
            src={coverImage}
            alt={`${title} visualisation`}
            widths={[240, 480]}
            sizes="(min-width: 640px) 192px, 100vw"
            class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-105"
          />
        </div>
      )}
      <h3
        class:list={["font-display text-2xl text-ink group-hover:text-flow transition-colors", featured && "sm:text-3xl"]}
      >
        {title}
      </h3>
      <p class="mt-3 text-ink-muted max-w-2xl leading-relaxed">{summary}</p>
      {solver && <p class="mt-4 font-mono text-xs text-ink-faint">SOLVER <span class="text-ink-muted">{solver}</span></p>}
      <div class="mt-4 flex flex-wrap gap-2">
        {stack.slice(0, 5).map((s) => <TechBadge label={s} />)}
      </div>
      {tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1 font-mono text-[11px] text-ink-faint">
          {tags.slice(0, 4).map((tag) => <span>#{tag}</span>)}
        </div>
      )}
    </div>

    <div class="sm:min-w-[9rem] sm:text-right font-mono text-xs shrink-0">
      <p class={statusColor}><span class="inline-block w-1.5 h-1.5 rounded-full bg-current mr-2 align-middle"></span>{status}</p>
      <p class="text-ink-faint mt-1">{year}</p>
      {metrics.length > 0 && (
        <dl class="mt-5 grid grid-cols-2 sm:block gap-x-4 gap-y-2 text-left sm:text-right">
          {metrics.slice(0, featured ? 4 : 2).map((metric) => (
            <div class="mt-2 first:mt-0">
              <dt class="text-[10px] uppercase tracking-wide text-ink-faint">{metric.label}</dt>
              <dd class="mt-0.5 text-ink">{metric.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  </div>
</a>
