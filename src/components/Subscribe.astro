---
// src/components/Subscribe.astro
---

<section class="border border-hairline rounded-lg p-8 sm:p-10 bg-void relative overflow-hidden group">
  <!-- Subtle decorative background glow -->
  <div class="absolute -top-32 -right-32 w-64 h-64 bg-flow/10 rounded-full blur-3xl group-hover:bg-flow/20 transition-colors duration-700 pointer-events-none"></div>

  <div class="relative z-10 grid md:grid-cols-2 gap-8 items-center">
    
    <!-- Text Content -->
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-vortex mb-3">System Notification</p>
      <h2 class="font-display text-2xl sm:text-3xl text-ink">
        Subscribe to <span class="text-flow">Field Notes</span>
      </h2>
      <p class="mt-3 text-ink-muted text-sm leading-relaxed max-w-md">
        Get an email whenever I publish a new story, travelogue, or engineering reflection. No spam. Just a simple ping with a summary and a link.
      </p>
    </div>

    <!-- Direct HTML Form connected to your specific follow.it URL -->
    <form 
      action="https://api.follow.it/subscription-form/b25lU2VBdGUwZFcvaTdtVDJnSzlqTyt0dEVFdGRjQ1dIaHE1NWpXT0xEZ1ptcmM4WFFqVTNuaVdZemRGZG54bThpbytUeFMwUStueTZOT0lYV0JzNHFCby92YytjQ3hFLzhjVFVVaEZHR3ZOK3ZkK3ZqaWhXNGJNRGpmVTdnQ0F8MktoNjNtY3pNdm1Vd21wTEUzVjBuNFArVXlHQTV4TXJYTGJzQmJyTWRHcz0=/8" 
      method="post" 
      target="_blank"
      class="flex flex-col sm:flex-row gap-3 w-full" 
      id="subscribe-form"
    >
      <input
        type="email"
        name="email"
        required
        placeholder="name@domain.com"
        class="flex-1 bg-void border border-hairline rounded px-4 py-3 text-ink text-sm font-mono focus:outline-none focus:border-flow focus:ring-1 focus:ring-flow transition-all placeholder:text-ink-faint"
      />
      <button
        type="submit"
        class="font-mono text-sm bg-flow text-void px-6 py-3 rounded shadow-glow-flow hover:brightness-110 transition shrink-0"
      >
        Subscribe &rarr;
      </button>
    </form>
  </div>

  <!-- Success Overlay -->
  <div id="subscribe-success" class="hidden absolute inset-0 bg-void/95 backdrop-blur-sm z-20 flex flex-col items-center justify-center border border-flow/30 rounded-lg">
    <p class="text-flow font-mono text-sm mb-2">// Status 200: OK</p>
    <h3 class="text-ink font-display text-2xl">Awaiting Confirmation.</h3>
    <p class="text-ink-muted mt-2 text-sm text-center max-w-sm">
      A new tab has opened to verify your subscription. Please complete it to receive field notes.
    </p>
    <button id="close-success" class="mt-6 text-xs font-mono border border-hairline px-4 py-2 rounded text-ink-muted hover:text-ink hover:border-ink/50 transition">
      Close Window [x]
    </button>
  </div>
</section>

<script>
  const form = document.getElementById("subscribe-form") as HTMLFormElement | null;
  const successOverlay = document.getElementById("subscribe-success");
  const closeBtn = document.getElementById("close-success");

  // When form submits (opens in new tab), show our success overlay locally
  form?.addEventListener("submit", () => {
    // Slight delay so the browser can process the new tab request first
    setTimeout(() => {
      successOverlay?.classList.remove("hidden");
      form.reset();
    }, 500);
  });

  closeBtn?.addEventListener("click", () => {
    successOverlay?.classList.add("hidden");
  });
</script>