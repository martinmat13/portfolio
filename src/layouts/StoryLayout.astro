---
import BaseLayout from "./BaseLayout.astro";
import Gallery from "../components/Gallery.astro";
import YouTubeEmbed from "../components/YouTubeEmbed.astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"stories">;
}

const { entry } = Astro.props;
const { title, kind, summary, date, youtubeId, coverImage, gallery, tags } = entry.data;
---

<BaseLayout title={title} description={summary}>
  <article class="max-w-4xl mx-auto px-6 py-16">
    <header class="fluid-reveal border-b border-hairline pb-10" data-fluid-reveal>
      <div class="flex flex-wrap items-center gap-3 font-mono text-xs uppercase tracking-wider text-ink-faint">
        <span>{date.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" })}</span>
        <span>·</span>
        <span class={kind === "video" ? "text-vortex" : "text-flow"}>{kind}</span>
      </div>
      <h1 class="mt-4 font-display text-4xl sm:text-5xl text-ink tracking-tight">{title}</h1>
      <p class="mt-5 text-lg text-ink-muted max-w-2xl leading-relaxed">{summary}</p>
    </header>

    {coverImage && (
      <div class="fluid-reveal mt-10 overflow-hidden rounded-lg border border-hairline" style="--fluid-delay: 100ms" data-fluid-reveal>
        <Image src={coverImage} alt={`${title} visualisation`} widths={[600, 1200, 1800]} sizes="100vw" />
      </div>
    )}

    <div class="fluid-reveal prose prose-invert prose-headings:font-display prose-headings:tracking-tight prose-a:text-flow prose-code:font-mono prose-code:text-vortex prose-strong:text-ink max-w-none mt-12" style="--fluid-delay: 160ms" data-fluid-reveal>
      <slot />
    </div>

    {youtubeId && (
      <div class="fluid-reveal mt-10" style="--fluid-delay: 220ms" data-fluid-reveal>
        <YouTubeEmbed youtubeId={youtubeId} title={title} />
      </div>
    )}

    {gallery.length > 0 && (
      <div class="fluid-reveal mt-10" style="--fluid-delay: 260ms" data-fluid-reveal>
        <Gallery images={gallery} alt={title} />
      </div>
    )}

    {tags.length > 0 && (
      <div class="mt-12 pt-6 border-t border-hairline flex flex-wrap gap-2">
        {tags.map((tag) => <span class="font-mono text-xs text-ink-faint">#{tag}</span>)}
      </div>
    )}

    <div class="mt-16">
      <a href="/stories" class="font-mono text-sm text-ink-muted hover:text-flow transition-colors">
        ← Back to all stories
      </a>
    </div>
  </article>
</BaseLayout>
