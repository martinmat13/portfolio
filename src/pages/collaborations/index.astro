---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const collabs = (await getCollection("collaborations")).sort(
  (a, b) => a.data.order - b.data.order
);
const renderedCollabs = await Promise.all(
  collabs.map(async (entry) => ({
    entry,
    Content: (await entry.render()).Content,
  }))
);
---

<BaseLayout
  title="Collaborations"
  description="Academic and professional collaborations outside my core CFD focus."
>
  <section class="max-w-6xl mx-auto px-6 py-20">
    <header class="mb-10 border-b border-hairline pb-8">
      <h1 class="font-display text-4xl sm:text-5xl text-ink tracking-tight">
        Collaborations
      </h1>
      <p class="mt-4 text-ink-muted max-w-xl leading-relaxed">
        Work done alongside other researchers, teams, and disciplines —
        add a new one by dropping an .mdx file into
        <code class="font-mono text-vortex">src/content/collaborations/</code>.
      </p>
    </header>

    <div class="grid sm:grid-cols-2 gap-6">
      {renderedCollabs.map(({ entry, Content }) => (
        <a
          href={`/collaborations/${entry.slug}`}
          class="group block border border-hairline rounded-lg p-6 hover:border-flow/40 hover:bg-void-raised transition-colors"
        >
          <p class="font-mono text-xs text-ink-faint">{entry.data.period}</p>
          <h2 class="font-display text-xl text-ink mt-2 group-hover:text-flow transition-colors">
            {entry.data.title}
          </h2>
          <p class="font-mono text-xs text-flow mt-1">
            {entry.data.partner} — {entry.data.role}
          </p>
          <p class="mt-3 text-ink-muted leading-relaxed">{entry.data.summary}</p>
          <div class="prose prose-invert prose-sm prose-p:text-ink-muted prose-p:leading-relaxed max-w-none mt-4 border-t border-hairline pt-4">
            <Content />
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            {entry.data.tags.map((t) => (
              <span class="font-mono text-xs text-ink-faint">#{t}</span>
            ))}
          </div>
          <span class="mt-5 inline-block font-mono text-xs text-ink-muted group-hover:text-flow transition-colors">
            View collaboration <span aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
