---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order || b.data.date.valueOf() - a.data.date.valueOf())
  .filter((p) => p.data.featured)
  .slice(0, 3);

const latestStory = (await getCollection("stories")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)[0];
---

<BaseLayout title="Home">
  <Hero />

  <section class="max-w-6xl mx-auto px-6 py-20">
    <div class="flex items-end justify-between mb-2">
      <h2 class="font-display text-3xl text-ink">Featured work</h2>
      <a href="/projects" class="font-mono text-sm text-ink-muted hover:text-flow transition-colors">
        all projects →
      </a>
    </div>
    <div>
      {projects.map((p, i) => (
        <ProjectRow
          index={i + 1}
          href={`/projects/${p.slug}`}
          title={p.data.title}
          summary={p.data.summary}
          stack={p.data.stack}
          status={p.data.status}
          date={p.data.date}
        />
      ))}
    </div>
  </section>

  {latestStory && (
    <section class="border-t border-hairline">
      <div class="max-w-6xl mx-auto px-6 py-20 flex flex-col sm:flex-row sm:items-center gap-8 justify-between">
        <div>
          <p class="font-mono text-xs text-vortex mb-2">latest from stories</p>
          <h2 class="font-display text-2xl text-ink">{latestStory.data.title}</h2>
          <p class="mt-2 text-ink-muted max-w-lg">{latestStory.data.summary}</p>
        </div>
        <a
          href={`/stories#${latestStory.slug}`}
          class="font-mono text-sm border border-hairline px-5 py-3 rounded hover:border-vortex/50 hover:text-vortex transition-colors shrink-0"
        >
          Watch / read →
        </a>
      </div>
    </section>
  )}
</BaseLayout>
