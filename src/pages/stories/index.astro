---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const stories = (await getCollection("stories")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.slug.localeCompare(b.slug)
);
const years = [...new Set(stories.map((story) => story.data.date.getFullYear()))];
---

<BaseLayout
  title="Stories"
  description="Trainspotting, humour, photography, and narrative alongside the technical work."
>
  <!-- 1. NEW INTERACTIVE CANVAS HERO -->
  <section class="relative overflow-hidden border-b border-hairline bg-void pt-20 pb-12 sm:pt-28 sm:pb-16" data-fluid-reveal>
    <!-- Light Trails Canvas -->
    <canvas id="train-trails-canvas" class="absolute inset-0 w-full h-full opacity-70"></canvas>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent to-void pointer-events-none"></div>

    <!-- Header Content & Filter (Placed over the canvas) -->
    <div class="relative z-10 max-w-6xl mx-auto px-6 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end pointer-events-none">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.24em] text-vortex pointer-events-auto">Field notes / {stories.length} entries</p>
        <h1 class="font-display text-4xl sm:text-5xl text-cyan-400 tracking-tight mt-4 pointer-events-auto">
          Stories & Reflections
        </h1>
        <p class="text-ink-muted mt-4 text-lg leading-relaxed max-w-2xl pointer-events-auto">
          While my day-to-day involves chasing convergence and tuning turbulence models, this space is dedicated to the world outside the terminal. From my roots in India to exploring the railways of Europe, these are my travelogues, personal milestones, and adventures beyond the computational mesh.
        </p>
      </div>

      <nav aria-label="Filter stories by year" class="story-filter glass-panel p-2 pointer-events-auto">
        <label class="story-filter__label" for="story-year-filter">View</label>
        <select id="story-year-filter" class="story-filter__select" aria-label="Filter stories by year">
          <option value="all">All years ({stories.length})</option>
          {years.map((year) => (
            <option value={year}>{year} ({stories.filter((story) => story.data.date.getFullYear() === year).length})</option>
          ))}
        </select>
      </nav>
    </div>
  </section>

  <!-- 2. STORIES GRID SECTION -->
  <section class="max-w-6xl mx-auto px-6 py-12">
    <div class="mb-8 flex items-center justify-between gap-4 font-mono text-xs text-ink-faint">
      <p id="story-filter-status" aria-live="polite">Showing all stories</p>
      <p>{years.length > 1 ? "Date order / newest first" : "A beginning"}</p>
    </div>

    <div class="story-grid" aria-label="Story index">
      {stories.map((s) => {
        const year = s.data.date.getFullYear();
        return (
          <a href={`/stories/${s.slug}`} class="story-card" data-story-year={year}>
            <div class="story-card__topline">
              <span>{s.data.date.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" })}</span>
              <span class={s.data.kind === "video" ? "text-vortex" : "text-flow"}>{s.data.kind}</span>
            </div>
            <div class="story-card__body">
              <h2 class="font-display text-2xl leading-tight text-ink">{s.data.title}</h2>
              <p class="story-card__summary">{s.data.summary}</p>
              <span class="story-card__link">Read story <span aria-hidden="true">-&gt;</span></span>
            </div>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>

<script>
  // --------------------------------------------------------
  // 1. STORY FILTER LOGIC (Your existing code)
  // --------------------------------------------------------
  const cards = document.querySelectorAll<HTMLElement>(".story-card[data-story-year]");
  const filter = document.querySelector<HTMLSelectElement>("#story-year-filter");
  const status = document.querySelector<HTMLElement>("#story-filter-status");

  filter?.addEventListener("change", () => {
    const year = filter.value;
    const visibleCount = [...cards].filter((card) => year === "all" || card.dataset.storyYear === year).length;
    cards.forEach((card) => {
      card.hidden = year !== "all" && card.dataset.storyYear !== year;
    });
    if (status) status.textContent = year === "all" ? "Showing all stories" : `Showing ${visibleCount} ${year} ${visibleCount === 1 ? "story" : "stories"}`;
  });

  // --------------------------------------------------------
  // 2. HIGH-SPEED TRAIN LIGHT TRAILS LOGIC
  // --------------------------------------------------------
  const canvas = document.getElementById("train-trails-canvas") as HTMLCanvasElement | null;
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas && !prefersReducedMotion) {
    const ctx = canvas.getContext("2d")!;
    let width = 0, height = 0, dpr = Math.min(window.devicePixelRatio || 1, 2);
    let targetMy = 0, currentMy = 0;

    const resize = () => {
      width = canvas.clientWidth; height = canvas.clientHeight;
      canvas.width = width * dpr; canvas.height = height * dpr;
      ctx.scale(dpr, dpr);
      targetMy = height / 2;
      currentMy = height / 2;
    };
    resize();
    window.addEventListener("resize", resize);

    // Track mouse Y for perspective shift
    window.addEventListener("mousemove", (e) => {
      const rect = canvas.getBoundingClientRect();
      targetMy = e.clientY - rect.top;
    });

    const COUNT = 150;
    type Trail = { x: number; y: number; z: number; length: number; speed: number; color: string };
    const trails: Trail[] = Array.from({ length: COUNT }, () => spawn());

    function spawn(t?: Trail): Trail {
      // ICE train & station light colors (orange, yellow, blue, white)
      const colors = ["255, 122, 26", "255, 200, 100", "0, 229, 255", "255, 255, 255"];
      const data = {
        x: width + Math.random() * width, // Spawn off-screen right
        y: (Math.random() - 0.5) * height * 2,
        z: 0.1 + Math.random() * 0.9, // depth (smaller = further away = slower)
        length: 50 + Math.random() * 150,
        speed: 10 + Math.random() * 20,
        color: colors[Math.floor(Math.random() * colors.length)]
      };
      if (t) Object.assign(t, data);
      return t || data;
    }

    function step() {
      ctx.fillStyle = "rgba(5, 8, 13, 0.25)"; // Motion blur fade
      ctx.fillRect(0, 0, width, height);

      // Smooth mouse Y interpolation
      currentMy += (targetMy - currentMy) * 0.05;
      const perspectiveOffset = (currentMy - height / 2) * 0.5;

      for (const t of trails) {
        const speed = t.speed * t.z;
        t.x -= speed; // Move left

        // Draw trail
        const actualY = height / 2 + t.y * t.z + perspectiveOffset * t.z;
        
        ctx.strokeStyle = `rgba(${t.color}, ${t.z})`;
        ctx.lineWidth = 2 * t.z;
        ctx.lineCap = "round";
        ctx.beginPath();
        ctx.moveTo(t.x, actualY);
        ctx.lineTo(t.x + t.length * t.z, actualY);
        ctx.stroke();

        if (t.x < -t.length) spawn(t); // Reset when off-screen left
      }
    }

    // Run animation only when in view
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        requestAnimationFrame(function loop() {
          step();
          if (entry.isIntersecting) requestAnimationFrame(loop);
        });
      }
    });
    observer.observe(canvas);
  }
</script>