---
import BaseLayout from "../layouts/BaseLayout.astro";

const links = [
  { label: "GitHub", href: "https://github.com/martinmat13" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/martin-mathew-ab6474199/" },
  { label: "Google Scholar", href: "https://scholar.google.com/citations?user=your-id" },
  { label: "YouTube", href: "https://www.youtube.com/@MechanicalExplorer" },
  { label: "Email", href: "mailto:mathewmartin012@gmail.com" },
];
---

<BaseLayout title="About" description="Bio, contact links, and CV.">
  <section class="max-w-3xl mx-auto px-6 py-20">
    <h1 class="font-display text-4xl sm:text-5xl text-ink tracking-tight">
      About
    </h1>

    <div class="prose prose-invert prose-a:text-flow max-w-none mt-8">
      <p>
        I'm an engineer working at the intersection of computational fluid
        dynamics, hydrodynamics, and numerical modelling — building solvers,
        tuning turbulence models, and chasing convergence in OpenFOAM, ANSYS
        Fluent, and LIGGGHTS.
      </p>
      <p>
        Outside the mesh, I spend time around railways and behind a camera —
        see <a href="/stories">Stories</a> for that side of things.
      </p>
      
      <h2 class="text-2xl font-display text-ink mt-12 mb-4">Get in Touch</h2>
      <p>
        I’d love to connect! Whether you have questions about my research, want to swap stories about transit adventures, or just want to chat about fluid dynamics, my inbox is always open. 
      </p>
      <p>
        You can find me on various social media platforms, where I share updates, technical insights, and behind-the-scenes moments from my journey as a researcher and student. If you have any inquiries, potential collaboration ideas, or just want to say hello, don’t hesitate to drop me a message through any of the channels below!
      </p>
    </div>

    <div class="mt-10 flex flex-wrap gap-4">
      {links.map((l) => (
        <a
          href={l.href}
          target="_blank"
          rel="noopener"
          class="font-mono text-sm border border-hairline px-4 py-2 rounded text-ink-muted hover:text-flow hover:border-flow/40 transition-colors"
        >
          {l.label}
        </a>
      ))}
      <a
        href="/cv/martin-cv.pdf"
        download
        class="font-mono text-sm bg-flow text-void px-4 py-2 rounded shadow-glow-flow hover:brightness-110 transition"
      >
        Download CV
      </a>
    </div>
  </section>
</BaseLayout>