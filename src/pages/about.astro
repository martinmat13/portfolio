---
import BaseLayout from "../layouts/BaseLayout.astro";

const links = [
  { label: "GitHub", href: "https://github.com/martinmat13" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/martin-mathew-ab6474199/" },
  { label: "Google Scholar", href: "https://scholar.google.com/citations?user=your-id" },
  { label: "YouTube", href: "https://www.youtube.com/@MechanicalExplorer" },
  { label: "Email", href: "mailto:mathewmartin012@gmail.com" },
];
---

<BaseLayout title="About" description="Bio, contact links, and CV.">
  <!-- Interactive Convergence Canvas Header -->
  <section class="relative overflow-hidden border-b border-hairline bg-void pt-20 pb-16 sm:pt-28 sm:pb-20" data-fluid-reveal>
    <canvas id="convergence-canvas" class="absolute inset-0 w-full h-full opacity-80"></canvas>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-void pointer-events-none"></div>

    <div class="relative z-10 max-w-3xl mx-auto px-6 pointer-events-none">
      <p class="font-mono text-xs uppercase tracking-[0.24em] text-flow pointer-events-auto">End of the line / Thank you for visiting</p>
      <h1 class="font-display text-4xl sm:text-5xl text-ink tracking-tight mt-4 pointer-events-auto">
        About 
      </h1>
      <p class="text-ink-muted mt-4 text-lg leading-relaxed pointer-events-auto">
        Thanks for taking the time to explore my corner of the web. Whether you're here to inspect my numerical solvers or browsing my travel field notes, I hope you found your visit worthwhile. The door's always open for a return trip.
      </p>
    </div>
  </section>

  <!-- Main Content & Contact Section -->
  <section class="max-w-3xl mx-auto px-6 py-16">
    <div class="prose prose-invert prose-a:text-flow max-w-none">
      <p>
        I'm an engineer working at the intersection of computational fluid
        dynamics, hydrodynamics, and numerical modelling. Outside the mesh, I spend time around railways and behind a camera —
        see <a href="/stories">Stories</a> for that side of things.
      </p>
      
      <h2 class="text-2xl font-display text-ink mt-12 mb-4">Get in Touch</h2>
      <p>
        I’d love to connect! Whether you have questions about my research, want to swap stories about transit adventures, or just want to chat about fluid dynamics, my inbox is always open. 
      </p>
      <p>
        You can find me on various social media platforms, where I share updates, technical insights, and behind-the-scenes moments from my journey as a researcher. If you have any inquiries, potential collaboration ideas, or just want to say hello, don’t hesitate to drop me a message through any of the channels below!
      </p>
    </div>

    <!-- Links and CV -->
    <div class="mt-10 flex flex-wrap gap-4">
      {links.map((l) => (
        <a
          href={l.href}
          target="_blank"
          rel="noopener"
          class="font-mono text-sm border border-hairline px-4 py-2 rounded text-ink-muted hover:text-flow hover:border-flow/40 transition-colors"
        >
          {l.label}
        </a>
      ))}
      <a
        href="/cv/martin-cv.pdf"
        download
        class="font-mono text-sm bg-flow text-void px-4 py-2 rounded shadow-glow-flow hover:brightness-110 transition"
      >
        Download CV
      </a>
    </div>

    <!-- Friendly Return Invitation Footer Note -->
    <div class="mt-16 pt-8 border-t border-hairline flex items-center justify-between font-mono text-xs text-ink-faint">
      <span>// System Status: Session complete</span>
      <a href="/" class="hover:text-flow transition-colors">Return to Homepage &rarr;</a>
    </div>
  </section>
</BaseLayout>

<script>
  // --------------------------------------------------------
  // CONVERGENCE CANVAS ANIMATION (Full Rainbow Spectrum)
  // --------------------------------------------------------
  const canvas = document.getElementById("convergence-canvas") as HTMLCanvasElement | null;
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas && !prefersReducedMotion) {
    const ctx = canvas.getContext("2d")!;
    let width = 0, height = 0, dpr = Math.min(window.devicePixelRatio || 1, 2);
    let mx = -1000, my = -1000, isRunning = false;

    const resize = () => {
      width = canvas.clientWidth; height = canvas.clientHeight;
      canvas.width = width * dpr; canvas.height = height * dpr;
      ctx.scale(dpr, dpr);
    };
    resize();
    
    window.addEventListener("resize", () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      resize();
    });

    window.addEventListener("mousemove", (e) => {
      const rect = canvas.getBoundingClientRect();
      mx = e.clientX - rect.left;
      my = e.clientY - rect.top;
    });
    
    window.addEventListener("mouseleave", () => { 
      mx = -1000; my = -1000; 
    });

    const COUNT = 160;
    type Particle = { x: number; y: number; vx: number; vy: number; size: number; color: string };
    const particles: Particle[] = [];

    // Full rainbow spectrum + bright vibrant accents
    const spectrumColors = [
      "0, 229, 255",   // Cyan (Flow)
      "255, 122, 26",  // Orange (Vortex)
      "255, 0, 128",   // Magenta / Hot Pink
      "147, 51, 234",  // Electric Purple
      "34, 197, 94",   // Lime Green
      "234, 179, 8",   // Bright Yellow
      "59, 130, 246",  // Royal Blue
      "236, 72, 153",  // Pink
      "16, 185, 129",  // Emerald
      "244, 63, 94",   // Rose Red
      "168, 85, 247"   // Violet
    ];

    function spawn(): Particle {
      const angle = Math.random() * Math.PI * 2;
      const dist = Math.max(width, height) * 0.5 + Math.random() * 100;
      const centerX = width / 2;
      const centerY = height / 2;
      
      const color = spectrumColors[Math.floor(Math.random() * spectrumColors.length)];

      return {
        x: centerX + Math.cos(angle) * dist,
        y: centerY + Math.sin(angle) * dist,
        vx: (centerX - (centerX + Math.cos(angle) * dist)) * 0.005,
        vy: (centerY - (centerY + Math.sin(angle) * dist)) * 0.005,
        size: 1.2 + Math.random() * 2.2,
        color: color
      };
    }

    for (let i = 0; i < COUNT; i++) particles.push(spawn());

    function step() {
      if (!isRunning) return;

      // Soft trailing fade
      ctx.fillStyle = "rgba(5, 8, 13, 0.12)";
      ctx.fillRect(0, 0, width, height);

      const centerX = width / 2;
      const centerY = height / 2;

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];

        const dx = centerX - p.x;
        const dy = centerY - p.y;
        const dist = Math.sqrt(dx * dx + dy * dy);

        p.vx += (dx / dist) * 0.02;
        p.vy += (dy / dist) * 0.02;

        p.vx *= 0.98;
        p.vy *= 0.98;

        const mdx = p.x - mx;
        const mdy = p.y - my;
        const mdist = Math.sqrt(mdx * mdx + mdy * mdy);
        if (mdx < 150 && mdy < 150 && mdist < 150 && mdist > 0) {
          p.vx += (mdx / mdist) * 0.5;
          p.vy += (mdy / mdist) * 0.5;
        }

        p.x += p.vx;
        p.y += p.vy;

        ctx.fillStyle = `rgba(${p.color}, 0.9)`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fill();

        if (dist < 20 || p.x < 0 || p.x > width || p.y < 0 || p.y > height) {
          particles[i] = spawn();
        }
      }

      requestAnimationFrame(step);
    }

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          if (!isRunning) {
            isRunning = true;
            requestAnimationFrame(step);
          }
        } else {
          isRunning = false;
        }
      },
      { threshold: 0 }
    );
    observer.observe(canvas);
  }
</script>