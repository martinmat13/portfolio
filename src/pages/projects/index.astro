---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectRow from "../../components/ProjectRow.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.order - b.data.order
);
const years = [...new Set(projects.map((project) => project.data.date.getFullYear()))];
const featuredProject = projects
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order || b.data.date.valueOf() - a.data.date.valueOf())[0] ?? projects[0];
const supportingProjects = projects.filter((project) => project !== featuredProject);
---

<BaseLayout
  title="Projects"
  description="CFD, numerical simulation, and engineering research projects — OpenFOAM, ANSYS Fluent, LIGGGHTS."
>
  <!-- 1. NEW INTERACTIVE CANVAS HERO -->
  <section class="relative overflow-hidden border-b border-hairline bg-void pt-20 pb-12 sm:pt-28 sm:pb-16" data-fluid-reveal>
    <!-- Wind Tunnel Canvas -->
    <canvas id="wind-tunnel-canvas" class="absolute inset-0 w-full h-full opacity-60"></canvas>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent to-void pointer-events-none"></div>

    <!-- Header Content & Filter (Placed over the canvas) -->
    <div class="relative z-10 max-w-6xl mx-auto px-6 grid lg:grid-cols-[1fr_auto] gap-8 items-end pointer-events-none">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-flow pointer-events-auto">Research index / 0{projects.length}</p>
        <h1 class="mt-4 font-display text-4xl sm:text-5xl text-ink tracking-tight pointer-events-auto">Engineering <span class="text-flow">Projects</span></h1>
        <p class="mt-4 text-ink-muted max-w-xl leading-relaxed pointer-events-auto">
          Numerical simulation and engineering research, recorded as studies with
          reproducible methods, operating conditions, and observed results.
        </p>
      </div>
      
      <!-- Year Filter Dropdown -->
      <nav aria-label="Filter projects by year" class="story-filter glass-panel p-2 pointer-events-auto">
        <label class="story-filter__label" for="project-year-filter">View</label>
        <select id="project-year-filter" class="story-filter__select" aria-label="Filter projects by year">
          <option value="all">All years ({projects.length})</option>
          {years.map((year) => (
            <option value={year}>{year} ({projects.filter((project) => project.data.date.getFullYear() === year).length})</option>
          ))}
        </select>
      </nav>
    </div>
  </section>

  <!-- 2. PROJECT LIST SECTION -->
  <section class="max-w-6xl mx-auto px-6 py-12">
    <div class="mb-8 flex items-center justify-between gap-4 font-mono text-xs text-ink-faint">
      <p id="project-filter-status" aria-live="polite">Showing all projects</p>
      <p>{years.length > 1 ? "Newest first" : "A beginning"}</p>
    </div>

    {featuredProject && (
      <div
        class="project-feature fluid-reveal mt-6"
        style="--fluid-delay: 100ms"
        data-fluid-reveal
        data-project-year={featuredProject.data.date.getFullYear()}
      >
        <div class="project-feature__signal" aria-hidden="true">
          <span class="project-feature__line"></span>
          <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-vortex">Featured study</span>
        </div>
        <ProjectRow
          index={1}
          href={`/projects/${featuredProject.slug}`}
          title={featuredProject.data.title}
          summary={featuredProject.data.summary}
          stack={featuredProject.data.stack}
          tags={featuredProject.data.tags}
          solver={featuredProject.data.solver}
          metrics={featuredProject.data.metrics}
          status={featuredProject.data.status}
          date={featuredProject.data.date}
          coverImage={featuredProject.data.coverImage}
          featured
        />
      </div>
    )}

    {supportingProjects.length > 0 && (
      <div class="fluid-reveal mt-14" style="--fluid-delay: 180ms" data-fluid-reveal>
        <div class="flex items-center justify-between gap-4 mb-2">
          <h2 class="font-mono text-xs uppercase tracking-[0.18em] text-ink-faint">All studies</h2>
          <span class="font-mono text-xs text-ink-faint">{String(supportingProjects.length).padStart(2, "0")} records</span>
        </div>
        <div>
          {supportingProjects.map((p, i) => (
            <div data-project-year={p.data.date.getFullYear()}>
              <ProjectRow
                index={i + 2}
                href={`/projects/${p.slug}`}
                title={p.data.title}
                summary={p.data.summary}
                stack={p.data.stack}
                tags={p.data.tags}
                solver={p.data.solver}
                metrics={p.data.metrics}
                status={p.data.status}
                date={p.data.date}
                coverImage={p.data.coverImage}
              />
            </div>
          ))}
        </div>
      </div>
    )}
  </section>
</BaseLayout>

<script>
  // --------------------------------------------------------
  // 1. PROJECT FILTER LOGIC (Your existing code)
  // --------------------------------------------------------
  const entries = document.querySelectorAll<HTMLElement>("[data-project-year]");
  const filter = document.querySelector<HTMLSelectElement>("#project-year-filter");
  const status = document.querySelector<HTMLElement>("#project-filter-status");

  filter?.addEventListener("change", () => {
    const year = filter.value;
    const visibleCount = [...entries].filter((entry) => year === "all" || entry.dataset.projectYear === year).length;
    entries.forEach((entry) => {
      entry.hidden = year !== "all" && entry.dataset.projectYear !== year;
    });
    if (status) status.textContent = year === "all" ? "Showing all projects" : `Showing ${visibleCount} ${year} ${visibleCount === 1 ? "project" : "projects"}`;
  });

  // --------------------------------------------------------
  // 2. WIND TUNNEL CANVAS LOGIC
  // --------------------------------------------------------
  const canvas = document.getElementById("wind-tunnel-canvas") as HTMLCanvasElement | null;
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas && !prefersReducedMotion) {
    const ctx = canvas.getContext("2d")!;
    let width = 0, height = 0, dpr = Math.min(window.devicePixelRatio || 1, 2);
    let mx = -1000, my = -1000, targetMx = -1000, targetMy = -1000;

    const resize = () => {
      width = canvas.clientWidth; height = canvas.clientHeight;
      canvas.width = width * dpr; canvas.height = height * dpr;
      ctx.scale(dpr, dpr);
    };
    resize();
    window.addEventListener("resize", resize);

    // Track mouse coordinates relative to the canvas
    window.addEventListener("mousemove", (e) => {
      const rect = canvas.getBoundingClientRect();
      targetMx = e.clientX - rect.left;
      targetMy = e.clientY - rect.top;
    });
    window.addEventListener("mouseleave", () => { targetMx = -1000; targetMy = -1000; });

    const COUNT = 300;
    type P = { x: number; y: number; speed: number; length: number; hue: string };
    const particles: P[] = Array.from({ length: COUNT }, () => spawn());

    function spawn(p?: P): P {
      const isVortex = Math.random() > 0.8;
      const data = {
        x: p ? -50 : Math.random() * width, 
        y: Math.random() * height,
        speed: 1.5 + Math.random() * 2,
        length: 20 + Math.random() * 40,
        hue: isVortex ? "255, 122, 26" : "0, 229, 255" // Combines your 'vortex' and 'flow' theme colors
      };
      if (p) Object.assign(p, data);
      return p || data;
    }

    function step() {
      ctx.fillStyle = "rgba(5, 8, 13, 0.2)"; // Trailing fade effect matching your bg-void
      ctx.fillRect(0, 0, width, height);

      // Smooth mouse interpolation
      mx += (targetMx - mx) * 0.1;
      my += (targetMy - my) * 0.1;

      for (const p of particles) {
        let vx = p.speed;
        let vy = 0;

        // Mouse Repulsion Effect (Simulating a bluff body in the flow)
        const dx = p.x - mx;
        const dy = p.y - my;
        const distSq = dx * dx + dy * dy;
        const radius = 120;

        if (distSq < radius * radius && distSq > 0) {
          const dist = Math.sqrt(distSq);
          const force = (radius - dist) / radius;
          vx += (dx / dist) * force * 4.5;
          vy += (dy / dist) * force * 4.5;
        }

        const nx = p.x + vx;
        const ny = p.y + vy;

        ctx.strokeStyle = `rgba(${p.hue}, 0.7)`;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(p.x - vx * 4, p.y - vy * 4); // Draw dynamic trail
        ctx.lineTo(nx, ny);
        ctx.stroke();

        p.x = nx;
        p.y = ny;

        // Respawn particles when they exit the screen
        if (p.x > width + 50 || p.y < -50 || p.y > height + 50) spawn(p);
      }
      requestAnimationFrame(step);
    }
    
    // Only run animation when canvas is in view to save performance
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        requestAnimationFrame(step);
      }
    });
    observer.observe(canvas);
  }
</script>